  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "commands": {
    "auto-fill": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Auto-fill the current job application with Vecta"
    }
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
